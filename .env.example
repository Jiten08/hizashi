# Copy to .env and edit. Secrets stay empty here.
# Windows consoles are cp1252; honcho crashes printing ₹ without this.
PYTHONUTF8=1

SIM_DAY=2026-10-31
SIM_SPEED=60
SIM_SEED=31
LAT=12.93
LON=77.55
ALT=900

RETAIL_ENERGY_CHARGE=5.80
FEE_PER_KWH=0.14
MIN_TRADE_KWH=0.05
SELLER_OPEN_DISCOUNT=0.40
BUYER_OPEN_PRICE=4.00
MAX_ROUNDS=6
CONCESSION_BETA=1.0
EXPECTED_P2P_PRICE=4.68
NEGOTIATION_ROUND_DELAY_MS=700

HUB_URL=http://127.0.0.1:8000
# Address phones use. Leave empty: the hub picks up a running `ngrok http 8000` by itself.
# Set it only for a fixed domain, e.g. https://hizashi.ngrok-free.app
PUBLIC_URL=
# The hub starts ngrok for the QR codes when it's installed; 0 turns that off.
AUTO_NGROK=1

AGENT_TOKEN_H12=dev-h12
AGENT_TOKEN_H14=dev-h14
AGENT_TOKEN_H16=dev-h16
AGENT_TOKEN_H18=dev-h18

# Phase 3
GEMINI_API_KEY=
GROQ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_H12=
OWNER_WHATSAPP_H14=
